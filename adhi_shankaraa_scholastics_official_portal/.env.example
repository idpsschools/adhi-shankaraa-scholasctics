# EmailJS credentials — https://dashboard.emailjs.com/
# Fill these in. They are exposed to the browser (EmailJS is a client-side service),
# so use EmailJS's "Allowed Origins" / domain allow-list in the dashboard to restrict use.
# Restart `npm run dev` after editing this file.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
